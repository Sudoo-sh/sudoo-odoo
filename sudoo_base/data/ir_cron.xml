<odoo>
    <data noupdate="1">
        <record id="ir_cron_sudoo_sync" model="ir.cron">
            <field name="name">Sudoo.sh: read instances from the panels</field>
            <field name="model_id" ref="model_sudoo_instance"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
