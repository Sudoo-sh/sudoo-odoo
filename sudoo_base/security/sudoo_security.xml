<odoo>
    <record id="res_groups_privilege_sudoo" model="res.groups.privilege">
        <field name="name">Sudoo.sh</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_sudoo_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sudoo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the company's instances, creates new ones and starts, pauses, restarts and backs them up.</field>
    </record>

    <record id="group_sudoo_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sudoo"/>
        <field name="implied_ids" eval="[(4, ref('group_sudoo_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Also connects panels (API token), extends lifetimes and deletes instances.</field>
    </record>

</odoo>
