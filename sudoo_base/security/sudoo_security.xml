<odoo>
    <record id="module_category_sudoo" model="ir.module.category">
        <field name="name">Sudoo.sh</field>
        <field name="description">Create and manage Sudoo.sh Odoo instances.</field>
        <field name="sequence">40</field>
        <field name="parent_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_sudoo_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sudoo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the company's instances, creates new ones and starts, pauses, restarts and backs them up.</field>
    </record>

    <record id="group_sudoo_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_sudoo"/>
        <field name="implied_ids" eval="[(4, ref('group_sudoo_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Also connects panels (API token), extends lifetimes and deletes instances.</field>
    </record>

    <data noupdate="1">
        <record id="sudoo_server_company_rule" model="ir.rule">
            <field name="name">Sudoo.sh panels: own companies</field>
            <field name="model_id" ref="model_sudoo_server"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="sudoo_server_version_company_rule" model="ir.rule">
            <field name="name">Sudoo.sh versions: own companies</field>
            <field name="model_id" ref="model_sudoo_server_version"/>
            <field name="domain_force">[('server_id.company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="sudoo_instance_company_rule" model="ir.rule">
            <field name="name">Sudoo.sh instances: own companies</field>
            <field name="model_id" ref="model_sudoo_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
