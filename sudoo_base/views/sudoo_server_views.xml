<odoo>
    <record id="sudoo_server_view_list" model="ir.ui.view">
        <field name="name">sudoo.server.list</field>
        <field name="model">sudoo.server</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="instance_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sudoo_server_view_form" model="ir.ui.view">
        <field name="name">sudoo.server.form</field>
        <field name="model">sudoo.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test connection" class="btn-primary"/>
                    <button name="action_sync" type="object" string="Read instances now"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_instances" type="object" class="oe_stat_button" icon="fa-server">
                            <field name="instance_count" widget="statinfo" string="Instances"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Our Sudoo.sh panel"/></h1></div>
                    <group>
                        <group string="Connection">
                            <field name="url" placeholder="https://panel.example.com"/>
                            <field name="token" password="True"/>
                            <field name="secret" password="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Lifetime and limits">
                            <field name="default_lifetime_days"/>
                            <field name="max_lifetime_days"/>
                            <field name="max_instances_per_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="What users may create" name="policy">
                            <group>
                                <group string="Kinds of instance">
                                    <field name="allow_plain"/>
                                    <field name="allow_repository"/>
                                    <field name="allow_enterprise"/>
                                    <field name="allow_demo_data"/>
                                </group>
                                <group string="Odoo versions">
                                    <field name="version_ids" nolabel="1" colspan="2" create="false" delete="false">
                                        <tree editable="bottom" create="false" delete="false">
                                            <field name="name"/>
                                            <field name="enterprise_available"/>
                                            <field name="allowed" widget="boolean_toggle"/>
                                        </tree>
                                    </field>
                                </group>
                            </group>
                            <div class="text-muted">
                                The panel's own settings and limits apply too: these switches can only narrow them.
                                <b>Test connection</b> reads the versions the panel offers.
                            </div>
                        </page>
                    </notebook>
                    <div class="text-muted">
                        Create the token in the panel under <b>API tokens</b>, with the <b>Instances</b> scope.
                        The panel shows the token and its signing secret once: paste both here.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sudoo_server" model="ir.actions.act_window">
        <field name="name">Panels</field>
        <field name="res_model">sudoo.server</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
